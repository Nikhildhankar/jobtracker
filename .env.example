# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# For local MongoDB: mongodb://localhost:27017/jobtracker
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/jobtracker
MONGODB_URI=mongodb://localhost:27017/jobtracker

# Security & Session
SESSION_SECRET=super_secret_session_key_jobtracker_2026_dev_mode_change_in_prod

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
