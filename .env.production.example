# Production Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Production Connection String
MONGODB_URI=mongodb://localhost:27017/jobtracker

# Cryptographic Session Secret (Min 32 characters)
SESSION_SECRET=super_secret_production_key_change_me_in_prod

# Google Gemini API Key for AI Features
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Client Origin for CORS (e.g., https://jobtracker.app)
CLIENT_URL=https://jobtracker.app
